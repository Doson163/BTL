# Copy this file to .env and replace every password before starting Docker.
WEB_PORT=8080

DB_NAME=baitaplon
DB_USER=winmart
DB_PASSWORD=replace-with-a-long-random-database-password
DB_ROOT_PASSWORD=replace-with-a-different-long-random-root-password

ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-admin-password
ADMIN_DISPLAY_NAME=Quản trị viên

# Generate a private random value (at least 32 characters) for WebSocket chat authentication.
CHAT_JWT_SECRET=replace-with-a-random-secret-at-least-32-characters

# For local Docker use the values below. On deployment, change both to your HTTPS domain.
APP_BASE_URL=http://localhost:8080/Baitaplon
WINMART_GOOGLE_CLIENT_ID=
WINMART_GOOGLE_CLIENT_SECRET=
WINMART_GOOGLE_REDIRECT_URI=http://localhost:8080/Baitaplon/store.php?url=CustomerAuth/GoogleCallback

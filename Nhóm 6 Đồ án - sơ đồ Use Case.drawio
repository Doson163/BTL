  <diagram id="detail-9" name="9. Use Case chi tiết – Theo dõi và cập nhật trạng thái đơn">
    <mxGraphModel dx="1600" dy="850" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="850" math="0" shadow="0">

  BorderColor #000000
  FontColor #000000
}
skinparam actor {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}
skinparam note {
  BackgroundColor #FFFFFF
  BorderColor #000000
  FontColor #000000
}

actor "Khách hàng" as KH
actor "Quản trị viên" as Admin
rectangle "Hệ thống DailyMart" {
  usecase "Theo dõi đơn hàng" as UC_Track
  usecase "Xác nhận đã nhận hàng" as UC_Received
  usecase "Cập nhật trạng thái đơn" as UC_Update
  usecase "Đăng nhập" as UC_Login

  note right of UC_Track
    Khách hàng chỉ xem đơn thuộc tài khoản mình.
    Trạng thái hiển thị: Chờ xác nhận,
    Chờ lấy hàng, Đang giao, Hoàn thành, Đã hủy.
  end note

  note right of UC_Update
    Quản trị viên cập nhật đơn sang
    Chờ lấy hàng hoặc Đang giao.
    Khách hàng xác nhận đã nhận khi đơn đang giao
    để chuyển đơn sang Hoàn thành (3 → 4).
  end note
}
KH -- UC_Track
KH -- UC_Received
Admin -- UC_Update
UC_Track ..> UC_Login : <<include>>
UC_Received ..> UC_Login : <<include>>
UC_Update ..> UC_Login : <<include>>
@enduml

